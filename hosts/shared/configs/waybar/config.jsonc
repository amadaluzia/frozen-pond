{
  "position": "top",
  "layer": "top",
  "height": 30,
  "modules-left": [
    "custom/icon",
    "wlr/taskbar"
  ],
  "modules-right": [
    "pulseaudio",
    "memory",
    "network",
    "disk",
    "clock",
    "custom/logout"
  ],
  "wlr/taskbar": {
    "format": "{icon}",
    "tooltip-format": "{title} | {app_id}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen"
  },
  "custom/icon": {
    "format": "󱄅",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "disk": {
    "format": " {used}/{total}",
  },
  "clock": {
    "format": "{:%H:%M}",
    "interval": 7
  },
  "memory": {
    "format": " {used}GB/{total}GB",
    "interval": 12
  },
  "network": {
    "format": "󰈀 {ifname}",
    "format-disconnected": "",
    "tooltip-format": "󰈀 {ifname} via {gwaddr}"
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%"
  },
  "custom/logout": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "niri msg action quit"
  }
}
