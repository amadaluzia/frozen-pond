# vim: set filetype:ini

sort=-time
layer=overlay
background-color=#161616
text-color=#f2f4f8
width=300
height=110
border-size=1
border-color=#161616
icons=0
max-icon-size=64
default-timeout=3000
ignore-timeout=1
font=monospace 13

[urgency=low]
text-color=#525252

[urgency=normal]
text-color=#33b1ff

[urgency=high]
text-color=#ee5396
default-timeout=10000

[category=mpd]
default-timeout=2000
group-by=category

[mode=do-not-disturb]
invisible=1
