# vim: set filetype:ini

sort=-time
layer=overlay
background-color=#161616
text-color=#f2f4f8
width=400
height=110
border-size=1
border-color=#161616
icons=1
max-icon-size=64
default-timeout=10000
ignore-timeout=1
font=monospace 13

[urgency=low]
text-color=#525252

[urgency=normal]
text-color=#f2f4f8

[urgency=high]
text-color=#ee5396
default-timeout=20000

[category=mpd]
default-timeout=7000
group-by=category

[mode=do-not-disturb]
invisible=1
