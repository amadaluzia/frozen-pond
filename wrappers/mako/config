# vim: set filetype:ini

sort=-time
layer=overlay
background-color=#161616
text-color=#FFFFFF
width=300
height=110
border-size=1
border-color=#262626
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=monospace 13

[urgency=low]
border-color=#525252

[urgency=normal]
border-color=#ee5396

[urgency=high]
border-color=#ff7eb6
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
