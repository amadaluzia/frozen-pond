from xonsh.xontribs import xontribs_load


xontribs_load([
  "sh",
  "direnv",
  "fish_completer",
])


execx($(starship init xonsh))


hostname = $HOSTNAME
aliases["rebs"] = f"nixos-rebuild switch --use-remote-sudo --flake ~/.config/nixos#{hostname}"
aliases["rebt"] = f"nixos-rebuild test --use-remote-sudo --flake ~/.config/nixos#{hostname}"

eza_options = "--group-directories-first --colour=always --colour-scale-mode=fixed --icons=auto --header --inode --git"
aliases["ls"] = f"eza -a {eza_options}"
aliases["l"] = f"eza {eza_options}"
aliases["ll"] = f"eza -l {eza_options}"
aliases["la"] = f"eza -la {eza_options}"

aliases["v"] = "nvim"
aliases["e"] = "emacsclient -nw"
