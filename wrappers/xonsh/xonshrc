from xonsh.xontribs import xontribs_load

execx($(starship init xonsh))

xontribs_load([
  "sh",
  "direnv",
  "fish_completer",
])

hostname = $HOSTNAME
eza_options = "--group-directories-first --colour=always --colour-scale-mode=fixed --icons=auto --header --inode --git"

aliases["rebs"] = f"nixos-rebuild switch --use-remote-sudo --flake /etc/nixos#{hostname}"
aliases["ls"] = f"eza -la {eza_options}"
aliases["l"] = f"eza -a {eza_options}"
aliases["v"] = "nvim"
aliases["e"] = "emacsclient -nw"

$GPG_TTY = $(tty)
