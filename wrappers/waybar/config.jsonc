{
  "position": "top",
  "layer": "top",
  "height": 36,
  "modules-left": [
    "custom/icon",
  ],
  "modules-center": [
    "niri/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "memory",
    "cpu",
    "disk",
    "clock"
  ],
  "custom/icon": {
    "format": "",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "cpu": {
    "format": " {usage}%",
  },
  "disk": {
    "format": " {used}/{total}",
  },
  "clock": {
    "format": "{:%H:%M}",
    "interval": 7
  },
  "memory": {
    "format": " {used}GB/{total}GB",
    "interval": 12
  },
  "network": {
    "format": "󰈀 {ifname}",
    "format-disconnected": "",
    "tooltip-format": "󰈀 {ifname} via {gwaddr}"
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%"
  },
  "custom/logout": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "niri msg action quit"
  }
}
